APP_NAME=AI Seed Studio
APP_ENV=development
APP_DEBUG=false
FRONTEND_URL=http://localhost:5173
POSTGRES_DB=ai_seed_studio
POSTGRES_USER=seed
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_TIMEOUT_SECONDS=30
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
MAX_IMAGE_SIZE_MB=15
MAX_IMAGE_PIXELS=24000000
MAX_MODEL_IMAGES=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Optional local account bootstrap and browser tests (never commit actual values)
# ADMIN_EMAIL=creator@example.com
# ADMIN_PASSWORD=

# Maximum product uploads; each also creates a processed preview.
MAX_PRODUCT_IMAGES=8


# Seedream official image service (set IMAGE_PROVIDER=seedream).
# Fill IMAGE_API_KEY with a new Ark API Key; never commit it.
# IMAGE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_API_TIMEOUT_SECONDS=180
# Seedream is image-only. Keep LLM_PROVIDER=local for local copy and product facts.
LLM_API_BASE_URL=
LLM_TIMEOUT_SECONDS=60
